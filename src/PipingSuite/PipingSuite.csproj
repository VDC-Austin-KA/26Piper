<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>PipingSuite</RootNamespace>
    <Version>1.0.0</Version>
    <!-- Copies NuGet dependencies (CommunityToolkit.Mvvm) next to the add-in DLL. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <!-- Allows building on non-Windows CI agents; Revit itself only runs on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference-only Revit 2026 API assemblies; Revit supplies them at runtime. -->
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2026.0.4" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2026.0.4" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <!--
    Release builds also produce dist/PipingSuite-<Version>.zip:
      Install.bat, Uninstall.bat, README.txt, PipingSuite.addin, PipingSuite/<binaries>
  -->
  <Target Name="CreateInstallPackage" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../..'))</RepoRoot>
      <DistDir>$(RepoRoot)/dist</DistDir>
      <StageDir>$(DistDir)/PipingSuite-$(Version)</StageDir>
    </PropertyGroup>
    <ItemGroup>
      <PackageBinaries Include="$(OutDir)**/*" />
      <InstallerFiles Include="$(RepoRoot)/installer/*" />
    </ItemGroup>

    <RemoveDir Directories="$(StageDir)" />
    <Copy SourceFiles="@(PackageBinaries)" DestinationFolder="$(StageDir)/PipingSuite/%(RecursiveDir)" />
    <Copy SourceFiles="@(InstallerFiles);PipingSuite.addin" DestinationFolder="$(StageDir)" />
    <ZipDirectory SourceDirectory="$(StageDir)" DestinationFile="$(DistDir)/PipingSuite-$(Version).zip" Overwrite="true" />
    <Message Importance="high" Text="Install package: $(DistDir)/PipingSuite-$(Version).zip" />
  </Target>

</Project>
