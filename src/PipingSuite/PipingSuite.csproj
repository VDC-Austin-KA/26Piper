<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>PipingSuite</RootNamespace>
    <!-- Copies NuGet dependencies (CommunityToolkit.Mvvm) next to the add-in DLL. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <!-- Allows building on non-Windows CI agents; Revit itself only runs on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference-only Revit 2026 API assemblies; Revit supplies them at runtime. -->
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2026.0.4" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2026.0.4" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="PipingSuite.addin" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
