<Window x:Class="PipingSuite.UI.Views.AssemblyOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Piping Assemblies" Width="400" SizeToContent="Height"
        ShowInTaskbar="False" ResizeMode="NoResize">
    <StackPanel Margin="12">
        <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" Margin="0,0,0,10" />

        <TextBlock Text="Group runs by parameters (none ticked = connectivity only)" />
        <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Filter parameter names" Margin="0,2,0,2" />
        <ListBox ItemsSource="{Binding ParametersView}" Height="180" Margin="0,0,0,10">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <CheckBox Content="Include fittings/accessories connected to selected pipes"
                  IsChecked="{Binding IncludeConnectedFittings}" Margin="0,0,0,10" />

        <TextBlock Text="Assembly name prefix" />
        <TextBox Text="{Binding NamePrefix, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,12" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Create" Width="80" IsDefault="True" Command="{Binding AcceptCommand}" />
            <Button Content="Cancel" Width="80" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
