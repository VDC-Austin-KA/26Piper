<Window x:Class="PipingSuite.UI.Views.ChangeSystemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Change System" Width="420" SizeToContent="Height"
        ShowInTaskbar="False" ResizeMode="NoResize">
    <StackPanel Margin="12">
        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,10" />

        <TextBlock Text="Change to system type" />
        <ComboBox ItemsSource="{Binding Systems}" SelectedItem="{Binding SelectedSystem}" Margin="0,2,0,8" />

        <CheckBox Content="Include connected piping on the same system (the whole run)" IsChecked="{Binding Connected}" Margin="0,2,0,8" />

        <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,12"
                   Text="Pipes take the new system type; fittings and valves follow the pipes they join. Where the change stops against piping still on the old system, the report lists it. One undo reverts it." />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Change" Width="80" IsDefault="True" Command="{Binding AcceptCommand}" />
            <Button Content="Cancel" Width="80" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
