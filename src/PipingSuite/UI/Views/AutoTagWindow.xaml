<Window x:Class="PipingSuite.UI.Views.AutoTagWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Auto Tag" Width="420" SizeToContent="Height"
        ShowInTaskbar="False" ResizeMode="NoResize">
    <StackPanel Margin="12">
        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,10" />

        <TextBlock Text="Tag" />
        <ComboBox ItemsSource="{Binding TagTypes}" SelectedItem="{Binding SelectedTagType}" Margin="0,2,0,8" />

        <TextBlock Text="One tag per unique value of" />
        <ComboBox ItemsSource="{Binding Parameters}" SelectedItem="{Binding SelectedParameter}" Margin="0,2,0,2" />
        <TextBlock Text="{Binding Preview}" TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,8" />

        <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,12"
                   Text="Each value gets one tag on its longest pipe, so identical branches off a header share one tag. Tags stack in a column with leaders, and the crop widens if they fall outside it. Tags of this type already on this piping are replaced. One undo removes them." />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Tag" Width="80" IsDefault="True" Command="{Binding AcceptCommand}" />
            <Button Content="Cancel" Width="80" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
