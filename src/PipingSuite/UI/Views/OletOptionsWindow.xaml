<Window x:Class="PipingSuite.UI.Views.OletOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Olet" Width="380" SizeToContent="Height"
        ShowInTaskbar="False" ResizeMode="NoResize">
    <StackPanel Margin="12">
        <TextBlock Text="{Binding Target}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10" />

        <TextBlock Text="Branch size" />
        <ComboBox ItemsSource="{Binding Sizes}" SelectedItem="{Binding SelectedSize}" Margin="0,2,0,8" />

        <TextBlock Text="Olet family type" />
        <ComboBox ItemsSource="{Binding Types}" SelectedItem="{Binding SelectedType}" Margin="0,2,0,8" />

        <TextBlock Text="Orientation around the pipe" />
        <ComboBox ItemsSource="{Binding Angles}" SelectedItem="{Binding SelectedAngle}" IsEnabled="{Binding IsInsert}" Margin="0,2,0,8" />

        <CheckBox Content="Keep placing with these settings (Esc to finish)" IsChecked="{Binding KeepPlacing}" Margin="0,2,0,8" />

        <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,12"
                   Text="Olets are always centred on the main's axis. Resizing keeps the centre and direction; a connected pipe is resized and reconnected." />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Width="80" IsDefault="True" Command="{Binding AcceptCommand}" />
            <Button Content="Cancel" Width="80" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
