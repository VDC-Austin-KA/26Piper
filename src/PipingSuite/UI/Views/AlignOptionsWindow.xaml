<Window x:Class="PipingSuite.UI.Views.AlignOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Align &amp; Connect" Width="440" SizeToContent="Height"
        ShowInTaskbar="False" ResizeMode="NoResize">
    <StackPanel Margin="12">
        <TextBlock Text="First:" FontWeight="SemiBold" />
        <TextBlock Text="{Binding FirstDescription}" TextWrapping="Wrap" Margin="0,0,0,4" />
        <TextBlock Text="Second:" FontWeight="SemiBold" />
        <TextBlock Text="{Binding SecondDescription}" TextWrapping="Wrap" Margin="0,0,0,10" />

        <TextBlock Text="Element to move" />
        <ComboBox ItemsSource="{Binding MoverOptions}" SelectedIndex="{Binding MoverIndex}" Margin="0,2,0,10" />

        <TextBlock Text="Correct misalignment along (project axes)" />
        <StackPanel Orientation="Horizontal" Margin="0,4,0,10">
            <CheckBox Content="X" IsChecked="{Binding AlignX}" Margin="0,0,16,0" />
            <CheckBox Content="Y" IsChecked="{Binding AlignY}" Margin="0,0,16,0" />
            <CheckBox Content="Z (elevation)" IsChecked="{Binding AlignZ}" />
        </StackPanel>

        <TextBlock Text="Maximum move (project units)" />
        <TextBox Text="{Binding ToleranceText, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,12" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Connect" Width="80" IsDefault="True" Command="{Binding AcceptCommand}" />
            <Button Content="Cancel" Width="80" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
