<Window x:Class="PipingSuite.UI.Views.BomWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ISO BOM" Width="400" SizeToContent="Height"
        ShowInTaskbar="False" ResizeMode="NoResize">
    <StackPanel Margin="12">
        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,10" />

        <TextBlock Text="Size (text height on the sheet)" />
        <ComboBox ItemsSource="{Binding Sizes}" SelectedItem="{Binding SelectedSize}" Margin="0,2,0,8" />

        <TextBlock Text="Place the table" />
        <ComboBox ItemsSource="{Binding Placements}" SelectedItem="{Binding SelectedPlacement}" Margin="0,2,0,8" />

        <CheckBox Content="Keep the crop square (otherwise tight around piping and table)" IsChecked="{Binding SquareCrop}" Margin="0,2,0,8" />

        <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,12"
                   Text="ITEM / QTY / SIZE / DESCRIPTION: pipe by type and size with its total length, fittings and valves by type and size with a count. The table is drawn in this view, so it goes onto the sheet with it, and the crop grows to take it in. Run again to resize or move it; the old table is replaced. One undo removes it." />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Add BOM" Width="80" IsDefault="True" Command="{Binding AcceptCommand}" />
            <Button Content="Cancel" Width="80" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
