<Window x:Class="PipingSuite.UI.Views.OverallMapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Overall ISO Map" Width="420" SizeToContent="Height"
        ShowInTaskbar="False" ResizeMode="NoResize">
    <StackPanel Margin="12">
        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBlock Text="{Binding Packages}" TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,10" />

        <TextBlock Text="New view name" />
        <TextBox Text="{Binding ViewName, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" />

        <CheckBox Content="Rainbow colors (otherwise distinct colors)" IsChecked="{Binding Rainbow}" Margin="0,2,0,8" />

        <TextBlock>
            <Run Text="Box transparency: " /><Run Text="{Binding Transparency, Mode=OneWay}" /><Run Text="%" />
        </TextBlock>
        <Slider Minimum="0" Maximum="90" TickFrequency="10" IsSnapToTickEnabled="True"
                Value="{Binding Transparency}" Margin="0,2,0,8" />

        <CheckBox Content="Add legend" IsChecked="{Binding Legend}" Margin="0,2,0,8" />

        <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,12"
                   Text="Duplicates the active plan with its detailing, then boxes each connected spool in its package color. Colors live on 'ISO MAP - &lt;package&gt;' filled region types: edit one there and re-runs keep it. One undo removes the view." />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Create" Width="80" IsDefault="True" Command="{Binding AcceptCommand}" />
            <Button Content="Cancel" Width="80" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
